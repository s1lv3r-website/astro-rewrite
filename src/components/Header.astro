---
import { SITE_NAME, PRONOUNS } from "@/constants";

const getPageClass = (name: string): string =>
  [`/${name}`, `/${name}/`].includes(Astro.url.pathname) ? "current-page" : "";
---

<header>
  <a href="/" id="titlecard">
    <!--
      Empty alt text as per https://www.w3.org/WAI/tutorials/images/decision-tree/ "Is the image purely decorative or not intended for users?".
      The logo is purely decorative and serves no meaningful purpose.
    -->
    <img id="logo" src="/logo.svg" aria-hidden="true" alt="" />
    <h1 id="sitetitle" aria-label="Silver">{SITE_NAME}</h1>
    <p id="pronouns">{PRONOUNS}</p>
  </a>
  <nav>
    <a href="/" class={getPageClass("")}> home</a><span aria-hidden> | </span>
    <a href="/blog" class={getPageClass("blog")}>blog</a><span aria-hidden> | </span>
    <a href="/links" class={getPageClass("links")}>links</a><span aria-hidden> | </span>
    <a href="/noai" class={getPageClass("noai")}>NoAI</a>
  </nav>
</header>

<style lang="scss">
  $wrapWidth: 52rem;

  header {
    display: flex;
    flex-direction: column;
    align-items: baseline;
    margin-bottom: 1rem;

    @media (width < $wrapWidth) {
      margin-left: auto;
      margin-right: auto;
    }

    @media (width >= $wrapWidth) {
      flex-direction: row;
    }

    a#titlecard {
      display: grid;
      grid-template-columns: auto auto;
      grid-template-rows: auto auto;
      grid-template-areas:
        "logo title"
        "logo pronouns";
      column-gap: 0.25rem;

      margin-right: auto;

      @media (width < $wrapWidth) {
        margin-left: auto;
      }

      img#logo {
        grid-area: logo;

        padding-bottom: 0.25rem;
        width: 4rem;
        height: 4rem;
        margin-top: auto;
        margin-bottom: auto;
      }

      h1#sitetitle {
        grid-area: title;
        margin-top: auto;
        margin-bottom: auto;
      }

      p#pronouns {
        grid-area: pronouns;
        padding-left: 0.1rem;
        margin: 0;
      }
    }

    nav {
      text-align: right;
      margin-top: auto;
      margin-bottom: auto;
    }


    .current-page {
      font-style: italic;
      font-weight: 600;
    }

    a {
      text-decoration: none;
    }
  }
</style>
